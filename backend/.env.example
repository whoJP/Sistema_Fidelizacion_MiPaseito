DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/paseo_points"
# Aiven (SSL required; download the project CA certificate to backend/prisma/ca.pem):
# DATABASE_URL="mysql://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslcert=ca.pem&sslaccept=strict"
# Long random string; signs session JWTs and customer QR codes.
JWT_SECRET="change-me"
PORT=4000
# Enables POST /api/demo/reset (wipes and reseeds the database). Never enable in production.
ALLOW_DEMO_RESET=false
# Shared secret for the read-only integration API used by Jarvis Paseo and the Paseito kiosk QR check
# (header X-API-Key). Empty disables it.
INTEGRATION_API_KEY=""
